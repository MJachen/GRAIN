{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRAIN patient-level split manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_name",
    "outer_fold",
    "seed",
    "train",
    "validation",
    "test",
    "k_candidates",
    "selected_k"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_name": {"type": "string", "minLength": 1},
    "outer_fold": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "train": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "validation": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "test": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "k_candidates": {
      "const": [2, 3, 4, 5, 6, 7, 8, 9, 10]
    },
    "selected_k": {
      "oneOf": [
        {"type": "integer", "minimum": 2, "maximum": 10},
        {"type": "null"}
      ]
    }
  },
  "additionalProperties": false
}

